[Unit]
Description=MyQuant Next.js Frontend
After=network.target myquant-backend.service
Wants=myquant-backend.service

[Service]
Type=simple
User=myquant
WorkingDirectory=/app/my_quant/frontend
EnvironmentFile=/app/my_quant/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node node_modules/.bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=myquant-frontend

[Install]
WantedBy=multi-user.target
